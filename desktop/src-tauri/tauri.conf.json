{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codeschmiede",
  "mainBinaryName": "Codeschmiede",
  "version": "0.2.0",
  "identifier": "at.kresak.codeschmiede",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Codeschmiede",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0f2a22"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "publisher": "Gerhard Kresak",
    "category": "DeveloperTool",
    "shortDescription": "Programmierumgebung für alle Apps",
    "longDescription": "Codeschmiede: Aufträge geben, live mitsehen, erlauben und freigeben – die Werkstatt arbeitet sie mit Claude ab.",
    "copyright": "© 2026 Gerhard Kresak",
    "resources": {
      "../dienst/": "dienst/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBQjE3RTg3NTQ0RDU3NjgKUldSb1YwMVVoMzZ4bWdxcTlPdWR3SlJoUFhNb25vQXNFcjhpK1VjRWQxdVVyeVFEVWh0cFlYTVIK",
      "endpoints": [
        "https://codeschmiede-updates.pages.dev/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
